# ============================================================================
# Everything Burger - Environment Configuration
# ============================================================================
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# The `.env` file is gitignored and never committed. Every variable below is
# optional except the API keys marked REQUIRED -- the app will still boot
# without them, but the features that depend on them will fail at runtime.
# ============================================================================

# ----------------------------------------------------------------------------
# API KEYS (REQUIRED)
# ----------------------------------------------------------------------------

# Mistral AI key for HTML generation, trinket naming, and summaries.
# Get one at: https://console.mistral.ai
MISTRAL_API_KEY=

# SerpAPI key for Google image / news / video / shopping search results.
# Get one at: https://serpapi.com
SERP_API_KEY=

# ----------------------------------------------------------------------------
# EMAIL (SMTP) -- used for password reset and welcome emails
# ----------------------------------------------------------------------------
# Any SMTP provider works (Gmail, SendGrid, your own mail server, etc.).
# Example for Gmail:
#   SMTP_SERVER=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=your-app-password
SMTP_SERVER=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# ----------------------------------------------------------------------------
# APP
# ----------------------------------------------------------------------------

# Public base URL used in password reset links.
# Use your real domain in production, e.g. https://everythingburger.ai
BASE_URL=http://localhost:8000

# Stable secret key for signing session cookies.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If left empty, a random key is generated on every start (sessions reset).
SECRET_KEY=

# Host/port the waitress server binds to.
HOST=0.0.0.0
PORT=8000

# Startup profile (1 = small, 2 = medium, 3 = large). Controls the waitress
# request thread pool, background worker pool, and SQLAlchemy connection pool.
# Can also be passed as a CLI arg:  python run.py 2
# EB2_PROFILE=2

# ----------------------------------------------------------------------------
# AI MODEL TUNING (optional)
# ----------------------------------------------------------------------------
# Override the Mistral models used for each stage of generation.
# CONTENT_MODEL=mistral-large-latest
# STRUCTURE_MODEL=codestral-latest
# STYLING_MODEL=mistral-medium-latest
# SUMMARY_MODEL=mistral-small-latest
