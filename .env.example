# ============================================================================
# Everything Burger - Environment Configuration
# ============================================================================
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# The `.env` file is gitignored and never committed. Every variable below is
# optional except the API keys marked REQUIRED -- the app will still boot
# without them, but the features that depend on them will fail at runtime.
# ============================================================================

# ----------------------------------------------------------------------------
# AI BACKEND (Bring Your Own Key)
# ----------------------------------------------------------------------------
# Pick which AI provider generates pages. Supported: mistral (recommended),
# openai, claude, ollama. Each provider needs its own API key below.
#   AI_BACKEND=mistral
#
# Mistral (recommended): https://console.mistral.ai
# MISTRAL_API_KEY=
#
# OpenAI: https://platform.openai.com
# OPENAI_API_KEY=
#
# Anthropic Claude: https://console.anthropic.com
# ANTHROPIC_API_KEY=
#
# Ollama Cloud: https://ollama.com  (set AI_BACKEND=ollama)
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=https://ollama.com
#
# Self-hosted Ollama (no key): set AI_BACKEND=ollama and point at your server
# OLLAMA_BASE_URL=http://localhost:11434
#
# Model overrides (per backend; defaults resolve automatically):
# CONTENT_MODEL=
# STRUCTURE_MODEL=
# STYLING_MODEL=
# SUMMARY_MODEL=

# ----------------------------------------------------------------------------
# SEARCH (optional but recommended)
# ----------------------------------------------------------------------------
# SerpAPI key for Google image / news / video / shopping search results.
# Pages still generate without it, just without live enrichment/images.
# Get one at: https://serpapi.com
SERP_API_KEY=

# ----------------------------------------------------------------------------
# EMAIL (SMTP) -- used for password reset and welcome emails
# ----------------------------------------------------------------------------
# Any SMTP provider works (Gmail, SendGrid, your own mail server, etc.).
# Example for Gmail:
#   SMTP_SERVER=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=your-app-password
SMTP_SERVER=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# ----------------------------------------------------------------------------
# APP
# ----------------------------------------------------------------------------

# Public base URL used in password reset links.
# Use your real domain in production, e.g. https://everythingburger.ai
BASE_URL=http://localhost:8000

# Stable secret key for signing session cookies.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If left empty, a random key is generated on every start (sessions reset).
SECRET_KEY=

# Host/port the waitress server binds to.
HOST=0.0.0.0
PORT=8000

# Redis connection. The task queue and generation state live here, so
# background work (page generation, iteration rewrites, watcher verdicts)
# survives restarts and is shared across processes.
REDIS_URL=redis://localhost:6379/0

# Startup profile (1 = small, 2 = medium, 3 = large). Controls the waitress
# request thread pool, embedded queue workers, and SQLAlchemy connection pool.
# Can also be passed as a CLI arg:  python run.py 2
# EB2_PROFILE=2
